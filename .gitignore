# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Virtual environments
venv/
ENV/
env/
.venv/
venv.bak/

# Installer logs
pip-log.txt

# Dependency lock files
*.lock

# Unit test / coverage
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Pyre type checker
.pyre/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# macOS
.DS_Store

# Logs
*.log
logs/

# Environment variables
.env
.env.*

# Database files
*.db
*.sqlite3

# Docker override files (local development)
docker-compose.override.yml

# Ignore the data folder contents created at runtime. Keep the folder but not its contents.
/data-layer/data/*
!/data-layer/data/.gitkeep

# Local configuration files
local_settings.py

# Misc
.cache/
__pypackages__/
